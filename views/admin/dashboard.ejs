<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            ocean: { 50:'#f0f7ff',100:'#e0effe',200:'#b9dffe',300:'#7cc5fd',400:'#36a9fa',500:'#0c8eeb',600:'#0070c9',700:'#0159a3',800:'#064b86',900:'#0b3f6f',950:'#07284a' },
            gold: { 50:'#fdfaef',100:'#f9f0d0',200:'#f3de9d',300:'#ecc96a',400:'#e5b43e',500:'#d4982a',600:'#c9a84c',700:'#8f6417',800:'#76501a',900:'#63431b',950:'#39230b' },
            navy: { 800:'#1a2744',900:'#0f172a',950:'#080d1a' }
          },
          fontFamily: { serif:['Cormorant Garamond','Georgia','serif'], sans:['Inter','system-ui','sans-serif'] }
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="font-sans bg-gray-50 text-gray-800">

<% if (typeof flash !== 'undefined' && flash) { %>
<div id="flash-msg" class="fixed top-4 right-4 z-[100] max-w-md animate-slide-in">
  <div class="px-6 py-4 rounded-lg shadow-2xl border <%= flash.type === 'success' ? 'bg-emerald-50 border-emerald-200 text-emerald-800' : 'bg-red-50 border-red-200 text-red-800' %>">
    <div class="flex items-center gap-3">
      <p class="text-sm font-medium"><%= flash.message %></p>
      <button onclick="this.closest('#flash-msg').remove()" class="ml-auto text-gray-400 hover:text-gray-600">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </div>
</div>
<script>setTimeout(() => { const el = document.getElementById('flash-msg'); if(el) el.remove(); }, 5000);</script>
<% } %>

<%- include('../partials/admin-sidebar') %>

<div class="md:ml-64 mt-16 md:mt-0 p-4 md:p-8">
  <div class="mb-8">
    <h1 class="text-3xl font-serif font-bold text-navy-900">Dashboard</h1>
    <p class="text-gray-500 text-sm mt-1">Welcome back! Here's an overview of your hotel.</p>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
    <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 rounded-xl bg-ocean-50 flex items-center justify-center">
          <svg class="w-6 h-6 text-ocean-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        </div>
      </div>
      <p class="text-2xl font-bold text-navy-900"><%= stats.totalRooms %></p>
      <p class="text-xs text-gray-400 uppercase tracking-wider mt-1">Total Rooms</p>
    </div>

    <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 rounded-xl bg-emerald-50 flex items-center justify-center">
          <svg class="w-6 h-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
      </div>
      <p class="text-2xl font-bold text-navy-900"><%= stats.totalBookings %></p>
      <p class="text-xs text-gray-400 uppercase tracking-wider mt-1">Total Bookings</p>
    </div>

    <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center">
          <svg class="w-6 h-6 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
      </div>
      <p class="text-2xl font-bold text-navy-900"><%= stats.totalRevenue.toLocaleString() %> <span class="text-sm font-normal">CFA</span></p>
      <p class="text-xs text-gray-400 uppercase tracking-wider mt-1">Total Revenue</p>
    </div>

    <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 rounded-xl bg-red-50 flex items-center justify-center">
          <svg class="w-6 h-6 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
      </div>
      <p class="text-2xl font-bold text-navy-900"><%= stats.unreadContacts %></p>
      <p class="text-xs text-gray-400 uppercase tracking-wider mt-1">Unread Messages</p>
    </div>
  </div>

  <!-- Quick Stats Row -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
    <div class="bg-amber-50 rounded-xl p-4 flex items-center gap-4">
      <div class="w-10 h-10 rounded-full bg-amber-200 flex items-center justify-center text-amber-800 font-bold text-sm"><%= stats.pendingBookings %></div>
      <div>
        <p class="text-sm font-semibold text-amber-900">Pending Bookings</p>
        <p class="text-xs text-amber-700">Awaiting confirmation</p>
      </div>
      <a href="/admin/bookings?status=pending" class="ml-auto text-xs text-amber-700 hover:text-amber-900 font-medium">View &rarr;</a>
    </div>
    <div class="bg-emerald-50 rounded-xl p-4 flex items-center gap-4">
      <div class="w-10 h-10 rounded-full bg-emerald-200 flex items-center justify-center text-emerald-800 font-bold text-sm"><%= stats.confirmedBookings %></div>
      <div>
        <p class="text-sm font-semibold text-emerald-900">Confirmed</p>
        <p class="text-xs text-emerald-700">Active reservations</p>
      </div>
      <a href="/admin/bookings?status=confirmed" class="ml-auto text-xs text-emerald-700 hover:text-emerald-900 font-medium">View &rarr;</a>
    </div>
    <div class="bg-ocean-50 rounded-xl p-4 flex items-center gap-4">
      <div class="w-10 h-10 rounded-full bg-ocean-200 flex items-center justify-center text-ocean-800 font-bold text-sm"><%= stats.totalUsers %></div>
      <div>
        <p class="text-sm font-semibold text-ocean-900">Registered Users</p>
        <p class="text-xs text-ocean-700">Total accounts</p>
      </div>
    </div>
  </div>

  <!-- Recent Bookings -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="p-6 border-b border-gray-100 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-navy-900">Recent Bookings</h2>
      <a href="/admin/bookings" class="text-xs text-ocean-600 hover:text-ocean-800 font-medium">View All &rarr;</a>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full admin-table">
        <thead>
          <tr class="bg-gray-50 text-xs text-gray-500 uppercase tracking-wider">
            <th class="px-6 py-3 text-left">Guest</th>
            <th class="px-6 py-3 text-left">Room</th>
            <th class="px-6 py-3 text-left">Check In</th>
            <th class="px-6 py-3 text-left">Amount</th>
            <th class="px-6 py-3 text-left">Status</th>
            <th class="px-6 py-3 text-left">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% if (recentBookings && recentBookings.length > 0) { %>
            <% recentBookings.forEach(b => { %>
              <tr>
                <td class="px-6 py-4">
                  <p class="text-sm font-medium text-navy-900"><%= b.guestName %></p>
                  <p class="text-xs text-gray-400"><%= b.guestEmail %></p>
                </td>
                <td class="px-6 py-4 text-sm text-gray-600"><%= b.room ? b.room.name : 'N/A' %></td>
                <td class="px-6 py-4 text-sm text-gray-600"><%= b.checkIn.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                <td class="px-6 py-4 text-sm font-semibold text-navy-900 price-tag"><%= b.totalPrice.toLocaleString() %> CFA</td>
                <td class="px-6 py-4"><span class="badge badge-<%= b.status %>"><%= b.status %></span></td>
                <td class="px-6 py-4">
                  <a href="/admin/bookings/<%= b._id %>" class="text-xs text-ocean-600 hover:text-ocean-800 font-medium">Details</a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="6" class="px-6 py-12 text-center text-gray-400">No bookings yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

</body>
</html>
