<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: {
        colors: {
          ocean: { 50:'#f0f7ff',100:'#e0effe',200:'#b9dffe',500:'#0c8eeb',600:'#0070c9',800:'#064b86',900:'#0b3f6f' },
          gold: { 50:'#fdfaef',400:'#e5b43e',500:'#d4982a',600:'#c9a84c' },
          navy: { 800:'#1a2744',900:'#0f172a',950:'#080d1a' }
        },
        fontFamily: { serif:['Cormorant Garamond','serif'], sans:['Inter','sans-serif'] }
      }}
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="font-sans bg-gray-50 text-gray-800">

<%- include('../partials/admin-sidebar') %>

<div class="md:ml-64 mt-16 md:mt-0 p-4 md:p-8">
  <div class="mb-8">
    <a href="/admin/rooms" class="text-sm text-ocean-600 hover:text-ocean-800 font-medium">&larr; Back to Rooms</a>
    <h1 class="text-3xl font-serif font-bold text-navy-900 mt-2"><%= room ? 'Edit Room' : 'Add New Room' %></h1>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8 max-w-3xl">
    <form action="<%= room ? '/admin/rooms/' + room._id + '?_method=PUT' : '/admin/rooms' %>" method="POST" enctype="multipart/form-data" class="space-y-6">

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Room Name *</label>
          <input type="text" name="name" required value="<%= room ? room.name : '' %>" placeholder="e.g. Deluxe Ocean View"
            class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-ocean-500 transition-colors">
        </div>
        <div>
          <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Room Type *</label>
          <select name="type" required class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-ocean-500 transition-colors appearance-none bg-white">
            <option value="">Select type</option>
            <% ['Standard', 'Deluxe', 'Suite', 'Presidential'].forEach(t => { %>
              <option value="<%= t %>" <%= room && room.type === t ? 'selected' : '' %>><%= t %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Short Description</label>
        <input type="text" name="shortDescription" value="<%= room ? room.shortDescription || '' : '' %>" placeholder="Brief one-liner"
          class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-ocean-500 transition-colors">
      </div>

      <div>
        <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Full Description *</label>
        <textarea name="description" required rows="5" placeholder="Detailed room description"
          class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-ocean-500 transition-colors resize-none"><%= room ? room.description : '' %></textarea>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Price per Night (CFA) *</label>
          <input type="number" name="price" required value="<%= room ? room.price : '' %>" placeholder="25000" min="0"
            class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-ocean-500 transition-colors">
        </div>
        <div>
          <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Max Capacity *</label>
          <input type="number" name="capacity" required value="<%= room ? room.capacity : 2 %>" min="1" max="20"
            class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-ocean-500 transition-colors">
        </div>
        <div>
          <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Room Size (m²)</label>
          <input type="number" name="size" value="<%= room && room.size ? room.size : '' %>" placeholder="30"
            class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-ocean-500 transition-colors">
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Bed Type</label>
          <input type="text" name="bedType" value="<%= room ? room.bedType || '' : '' %>" placeholder="e.g. King Size"
            class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-ocean-500 transition-colors">
        </div>
        <div>
          <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Amenities (comma-separated)</label>
          <input type="text" name="amenities" value="<%= room ? room.amenities.join(', ') : '' %>" placeholder="WiFi, AC, TV, Mini Bar"
            class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-ocean-500 transition-colors">
        </div>
      </div>

      <div>
        <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Room Images</label>
        <div class="border-2 border-dashed border-gray-200 rounded-xl p-8 text-center hover:border-ocean-400 transition-colors">
          <input type="file" name="images" multiple accept="image/*" id="image-input" class="hidden">
          <label for="image-input" class="cursor-pointer">
            <svg class="w-10 h-10 text-gray-300 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <p class="text-sm text-gray-500">Click to upload images</p>
            <p class="text-xs text-gray-400 mt-1">JPEG, PNG, WebP up to 5MB each</p>
          </label>
        </div>
      </div>

      <% if (room && room.images && room.images.length > 0) { %>
      <div>
        <label class="block text-xs text-gray-500 uppercase tracking-wider mb-3">Current Images</label>
        <div class="grid grid-cols-4 gap-3">
          <% room.images.forEach(img => { %>
            <div class="relative group">
              <img src="<%= img %>" alt="" class="w-full h-24 object-cover rounded-lg">
              <label class="absolute inset-0 bg-red-500/60 rounded-lg flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
                <input type="checkbox" name="removeImages" value="<%= img %>" class="hidden peer">
                <span class="text-white text-xs font-medium peer-checked:hidden">Remove</span>
                <span class="text-white text-xs font-medium hidden peer-checked:block">Removing</span>
              </label>
            </div>
          <% }); %>
        </div>
        <p class="text-xs text-gray-400 mt-2">Hover and click to mark images for removal</p>
      </div>
      <% } %>

      <div class="flex items-center gap-3">
        <input type="checkbox" name="featured" id="featured" class="w-4 h-4 rounded border-gray-300 text-ocean-600 focus:ring-ocean-500"
          <%= room && room.featured ? 'checked' : '' %>>
        <label for="featured" class="text-sm text-gray-600">Featured on homepage</label>
      </div>

      <div class="flex items-center gap-4 pt-4">
        <button type="submit" class="px-8 py-3 bg-gold-500 hover:bg-gold-600 text-navy-900 font-semibold rounded-lg text-sm transition-colors">
          <%= room ? 'Update Room' : 'Create Room' %>
        </button>
        <a href="/admin/rooms" class="px-8 py-3 border border-gray-200 text-gray-600 hover:bg-gray-50 rounded-lg text-sm transition-colors">Cancel</a>
      </div>
    </form>
  </div>
</div>

</body>
</html>
