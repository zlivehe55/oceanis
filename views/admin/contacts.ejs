<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: {
        colors: {
          ocean: { 50:'#f0f7ff',600:'#0070c9',900:'#0b3f6f' },
          gold: { 400:'#e5b43e',500:'#d4982a',600:'#c9a84c' },
          navy: { 800:'#1a2744',900:'#0f172a',950:'#080d1a' }
        },
        fontFamily: { serif:['Cormorant Garamond','serif'], sans:['Inter','sans-serif'] }
      }}
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="font-sans bg-gray-50 text-gray-800">

<% if (typeof flash !== 'undefined' && flash) { %>
<div id="flash-msg" class="fixed top-4 right-4 z-[100] max-w-md animate-slide-in">
  <div class="px-6 py-4 rounded-lg shadow-2xl border <%= flash.type === 'success' ? 'bg-emerald-50 border-emerald-200 text-emerald-800' : 'bg-red-50 border-red-200 text-red-800' %>">
    <p class="text-sm font-medium"><%= flash.message %></p>
  </div>
</div>
<script>setTimeout(() => { const el = document.getElementById('flash-msg'); if(el) el.remove(); }, 5000);</script>
<% } %>

<%- include('../partials/admin-sidebar') %>

<div class="md:ml-64 mt-16 md:mt-0 p-4 md:p-8">
  <div class="mb-8">
    <h1 class="text-3xl font-serif font-bold text-navy-900">Messages</h1>
    <p class="text-gray-500 text-sm mt-1">Contact form submissions</p>
  </div>

  <div class="space-y-4">
    <% if (contacts && contacts.length > 0) { %>
      <% contacts.forEach(c => { %>
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 <%= !c.read ? 'border-l-4 border-l-ocean-500' : '' %>">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-2">
                <h3 class="font-semibold text-navy-900"><%= c.subject %></h3>
                <% if (!c.read) { %>
                  <span class="px-2 py-0.5 bg-ocean-100 text-ocean-700 text-[10px] font-bold uppercase rounded-full">New</span>
                <% } %>
              </div>
              <p class="text-sm text-gray-600 mb-3"><%= c.message %></p>
              <div class="flex items-center gap-4 text-xs text-gray-400">
                <span class="font-medium text-gray-600"><%= c.name %></span>
                <a href="mailto:<%= c.email %>" class="text-ocean-600 hover:text-ocean-800"><%= c.email %></a>
                <% if (c.phone) { %><span><%= c.phone %></span><% } %>
                <span><%= c.createdAt.toLocaleDateString('en-GB', {day:'numeric',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></span>
              </div>
            </div>
            <div class="flex items-center gap-2 ml-4">
              <% if (!c.read) { %>
                <button onclick="markRead('<%= c._id %>', this)" class="px-3 py-1.5 bg-ocean-50 text-ocean-600 hover:bg-ocean-100 text-xs font-medium rounded-lg transition-colors">
                  Mark Read
                </button>
              <% } %>
              <form action="/admin/contacts/<%= c._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this message?');" class="inline">
                <button type="submit" class="p-1.5 text-gray-400 hover:text-red-500 transition-colors">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="text-center py-16 bg-white rounded-xl border border-gray-100">
        <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        <p class="text-gray-400">No messages yet.</p>
      </div>
    <% } %>
  </div>
</div>

<script>
  async function markRead(id, btn) {
    try {
      const res = await fetch(`/admin/contacts/${id}/read?_method=PUT`, { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        btn.closest('.bg-white').classList.remove('border-l-4', 'border-l-ocean-500');
        btn.remove();
      }
    } catch (e) {
      console.error(e);
    }
  }
</script>

</body>
</html>
