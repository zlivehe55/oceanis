<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: {
        colors: {
          ocean: { 50:'#f0f7ff',600:'#0070c9',900:'#0b3f6f' },
          gold: { 50:'#fdfaef',400:'#e5b43e',500:'#d4982a',600:'#c9a84c' },
          navy: { 800:'#1a2744',900:'#0f172a',950:'#080d1a' }
        },
        fontFamily: { serif:['Cormorant Garamond','Georgia','serif'], sans:['Inter','system-ui','sans-serif'] }
      }}
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .img-preview { max-height: 120px; border-radius: 8px; object-fit: cover; }
  </style>
</head>
<body class="font-sans bg-gray-50">
  <%- include('../partials/admin-sidebar') %>

  <div class="md:ml-64 mt-16 md:mt-0 p-4 md:p-8">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="flex items-center justify-between mb-8 flex-wrap gap-4">
        <div>
          <div class="flex items-center gap-3 mb-1">
            <a href="/admin/pages" class="text-gray-400 hover:text-navy-900 transition-colors">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </a>
            <h1 class="text-3xl font-serif font-bold text-navy-900"><%= pageLabel %></h1>
          </div>
          <p class="text-gray-500 ml-8">Edit the content displayed on the public <%= pageName %> page</p>
        </div>
        <a href="/<%= pageName === 'home' ? '' : pageName %>" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-lg text-sm text-gray-600 hover:border-ocean-600 hover:text-ocean-600 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          Preview Page
        </a>
      </div>

      <!-- Form -->
      <form action="/admin/pages/<%= pageName %>" method="POST">
        <% const sectionNames = Object.keys(sections); %>
        <% sectionNames.forEach((sectionName, si) => { %>
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 mb-6 overflow-hidden">
            <div class="px-6 py-4 bg-gray-50 border-b border-gray-100 flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-navy-900 flex items-center justify-center">
                <span class="text-xs font-bold text-white"><%= si + 1 %></span>
              </div>
              <h2 class="text-lg font-serif font-bold text-navy-900"><%= sectionName %></h2>
            </div>
            <div class="p-6 space-y-5">
              <% sections[sectionName].forEach(item => { %>
                <div>
                  <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5 font-medium"><%= item.label %></label>

                  <% if (item.type === 'text') { %>
                    <input type="text" name="<%= item.key %>" value="<%= item.value %>"
                      class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-ocean-600/20 focus:border-ocean-600 transition-all">

                  <% } else if (item.type === 'textarea') { %>
                    <textarea name="<%= item.key %>" rows="3"
                      class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-ocean-600/20 focus:border-ocean-600 transition-all resize-y"><%= item.value %></textarea>

                  <% } else if (item.type === 'image') { %>
                    <div class="space-y-3">
                      <input type="text" name="<%= item.key %>" value="<%= item.value %>"
                        class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-ocean-600/20 focus:border-ocean-600 transition-all font-mono text-xs"
                        oninput="document.getElementById('preview_<%= item.key %>').src = this.value"
                        placeholder="Enter image URL (e.g. https://images.unsplash.com/...)">
                      <% if (item.value) { %>
                        <div class="flex items-start gap-3">
                          <img id="preview_<%= item.key %>" src="<%= item.value %>" alt="Preview" class="img-preview w-48"
                            onerror="this.style.display='none'">
                          <span class="text-xs text-gray-400 mt-1">Live preview</span>
                        </div>
                      <% } %>
                    </div>
                  <% } %>
                </div>
              <% }); %>
            </div>
          </div>
        <% }); %>

        <!-- Save -->
        <div class="sticky bottom-0 bg-gray-50/80 backdrop-blur-md py-4 border-t border-gray-200 -mx-4 px-4 md:-mx-8 md:px-8 flex items-center justify-between">
          <p class="text-sm text-gray-400">Changes will appear on the live site immediately</p>
          <button type="submit" class="px-8 py-3 bg-gold-500 hover:bg-gold-600 text-navy-900 font-semibold rounded-lg text-sm uppercase tracking-wider transition-all duration-300 shadow-sm hover:shadow-md">
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
