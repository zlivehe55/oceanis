<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: {
        colors: {
          ocean: { 50:'#f0f7ff',600:'#0070c9',900:'#0b3f6f' },
          gold: { 50:'#fdfaef',400:'#e5b43e',500:'#d4982a',600:'#c9a84c' },
          navy: { 800:'#1a2744',900:'#0f172a',950:'#080d1a' }
        },
        fontFamily: { serif:['Cormorant Garamond','serif'], sans:['Inter','sans-serif'] }
      }}
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="font-sans bg-gray-50 text-gray-800">

<% if (typeof flash !== 'undefined' && flash) { %>
<div id="flash-msg" class="fixed top-4 right-4 z-[100] max-w-md animate-slide-in">
  <div class="px-6 py-4 rounded-lg shadow-2xl border <%= flash.type === 'success' ? 'bg-emerald-50 border-emerald-200 text-emerald-800' : 'bg-red-50 border-red-200 text-red-800' %>">
    <p class="text-sm font-medium"><%= flash.message %></p>
  </div>
</div>
<script>setTimeout(() => { const el = document.getElementById('flash-msg'); if(el) el.remove(); }, 5000);</script>
<% } %>

<%- include('../partials/admin-sidebar') %>

<div class="md:ml-64 mt-16 md:mt-0 p-4 md:p-8">
  <div class="mb-8">
    <h1 class="text-3xl font-serif font-bold text-navy-900">Gallery</h1>
    <p class="text-gray-500 text-sm mt-1">Manage your hotel gallery images</p>
  </div>

  <!-- Upload Form -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-8">
    <h2 class="text-lg font-semibold text-navy-900 mb-4">Upload New Image</h2>
    <form action="/admin/gallery" method="POST" enctype="multipart/form-data" class="flex flex-wrap items-end gap-4">
      <div class="flex-1 min-w-[200px]">
        <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Image *</label>
        <input type="file" name="image" required accept="image/*" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm">
      </div>
      <div class="w-48">
        <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Title</label>
        <input type="text" name="title" placeholder="Image title" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-ocean-500">
      </div>
      <div class="w-48">
        <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Category</label>
        <select name="category" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-ocean-500 appearance-none bg-white">
          <option value="rooms">Rooms</option>
          <option value="restaurant">Restaurant</option>
          <option value="pool">Pool</option>
          <option value="exterior">Exterior</option>
          <option value="events">Events</option>
          <option value="spa">Spa</option>
        </select>
      </div>
      <button type="submit" class="px-6 py-2.5 bg-gold-500 hover:bg-gold-600 text-navy-900 text-sm font-semibold rounded-lg transition-colors">
        Upload
      </button>
    </form>
  </div>

  <!-- Gallery Grid -->
  <% if (gallery && gallery.length > 0) { %>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      <% gallery.forEach(img => { %>
        <div class="relative group rounded-xl overflow-hidden bg-white shadow-sm border border-gray-100">
          <img src="<%= img.image %>" alt="<%= img.title || '' %>" class="w-full h-48 object-cover">
          <div class="absolute inset-0 bg-navy-900/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <form action="/admin/gallery/<%= img._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this image?');">
              <button type="submit" class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white text-xs font-medium rounded-lg transition-colors">
                Delete
              </button>
            </form>
          </div>
          <div class="p-3">
            <p class="text-sm font-medium text-navy-900 truncate"><%= img.title || 'Untitled' %></p>
            <p class="text-xs text-gray-400 capitalize"><%= img.category %></p>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="text-center py-16 bg-white rounded-xl border border-gray-100">
      <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      <p class="text-gray-400">No gallery images yet. Upload your first image above.</p>
    </div>
  <% } %>
</div>

</body>
</html>
