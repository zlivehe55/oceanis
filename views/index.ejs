<%- include('partials/header') %>

<!-- Hero Section -->
<section class="relative min-h-screen flex items-center justify-center hero-bg"
  style="background-image: url('https://images.unsplash.com/photo-1566073771259-6a8506099945?w=1920&q=80');">
  <div class="absolute inset-0 bg-gradient-to-b from-navy-950/70 via-navy-950/50 to-navy-950/90"></div>

  <div class="relative z-10 max-w-5xl mx-auto px-4 text-center">
    <div class="animate-fade-up">
      <p class="text-gold-400 text-sm md:text-base uppercase tracking-[0.3em] font-medium mb-6">
        Welcome to Oceanis
      </p>
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-serif font-bold text-white mb-6 leading-tight">
        Luxury on the<br>
        <span class="text-gradient">Coast of Douala</span>
      </h1>
      <p class="text-white/70 text-lg md:text-xl max-w-2xl mx-auto mb-10 font-light leading-relaxed">
        Experience world-class hospitality where the Atlantic meets refined elegance. 
        Your unforgettable stay begins here.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/rooms" class="px-10 py-4 bg-gold-500 hover:bg-gold-600 text-navy-900 font-semibold rounded text-sm uppercase tracking-wider transition-all duration-300 hover:shadow-lg hover:shadow-gold-500/25">
          Explore Rooms
        </a>
        <a href="/about" class="px-10 py-4 border border-white/30 text-white hover:bg-white/10 font-medium rounded text-sm uppercase tracking-wider transition-all duration-300">
          Discover More
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-float">
      <div class="w-6 h-10 border-2 border-white/30 rounded-full flex justify-center pt-2">
        <div class="w-1 h-3 bg-gold-400 rounded-full"></div>
      </div>
    </div>
  </div>
</section>

<!-- Booking Search Bar -->
<section class="relative z-20 -mt-12 px-4">
  <div class="max-w-5xl mx-auto">
    <form action="/rooms" method="GET" class="glass-dark rounded-2xl p-6 md:p-8 shadow-2xl">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
        <div>
          <label class="block text-white/60 text-xs uppercase tracking-wider mb-2">Check In</label>
          <input type="date" name="checkIn" class="w-full bg-white/10 border border-white/10 text-white rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-gold-500 transition-colors">
        </div>
        <div>
          <label class="block text-white/60 text-xs uppercase tracking-wider mb-2">Check Out</label>
          <input type="date" name="checkOut" class="w-full bg-white/10 border border-white/10 text-white rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-gold-500 transition-colors">
        </div>
        <div>
          <label class="block text-white/60 text-xs uppercase tracking-wider mb-2">Room Type</label>
          <select name="type" class="w-full bg-white/10 border border-white/10 text-white rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-gold-500 transition-colors appearance-none">
            <option value="all" class="text-gray-900">All Rooms</option>
            <option value="Standard" class="text-gray-900">Standard</option>
            <option value="Deluxe" class="text-gray-900">Deluxe</option>
            <option value="Suite" class="text-gray-900">Suite</option>
            <option value="Presidential" class="text-gray-900">Presidential</option>
          </select>
        </div>
        <button type="submit" class="w-full bg-gold-500 hover:bg-gold-600 text-navy-900 font-semibold py-3 rounded-lg text-sm uppercase tracking-wider transition-all duration-300">
          Search Rooms
        </button>
      </div>
    </form>
  </div>
</section>

<!-- Welcome Section -->
<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div data-aos="fade-right">
        <p class="text-gold-600 text-sm uppercase tracking-[0.2em] font-medium mb-4">About Oceanis</p>
        <h2 class="text-4xl md:text-5xl font-serif font-bold text-navy-900 mb-6 leading-tight">
          A Haven of<br>Refined Luxury
        </h2>
        <div class="gold-line mb-8"></div>
        <p class="text-gray-600 leading-relaxed mb-6">
          Nestled in the vibrant heart of Douala, Oceanis Hotel offers an extraordinary blend of 
          Cameroonian warmth and world-class sophistication. Every detail has been thoughtfully 
          curated to ensure your comfort and delight.
        </p>
        <p class="text-gray-600 leading-relaxed mb-8">
          From our elegantly appointed rooms with ocean-inspired design to our exceptional dining 
          and spa experiences, we invite you to discover a new standard of hospitality on the 
          West African coast.
        </p>
        <a href="/about" class="inline-flex items-center gap-2 text-ocean-700 font-semibold text-sm hover:text-gold-600 transition-colors group">
          Learn More About Us
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
      <div data-aos="fade-left" class="relative">
        <img src="https://images.unsplash.com/photo-1582719508461-905c673771fd?w=600&q=80" 
             alt="Oceanis Hotel Lobby" 
             class="rounded-2xl shadow-2xl w-full h-[500px] object-cover">
        <div class="absolute -bottom-6 -left-6 bg-gold-500 text-navy-900 p-6 rounded-xl shadow-lg">
          <p class="text-3xl font-serif font-bold">15+</p>
          <p class="text-sm font-medium uppercase tracking-wide">Years of Excellence</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Featured Rooms -->
<section class="py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16" data-aos="fade-up">
      <p class="text-gold-600 text-sm uppercase tracking-[0.2em] font-medium mb-4">Accommodation</p>
      <h2 class="text-4xl md:text-5xl font-serif font-bold text-navy-900 mb-4">Our Finest Rooms</h2>
      <div class="gold-line mx-auto mb-6"></div>
      <p class="text-gray-500 max-w-2xl mx-auto">Each room is a sanctuary of comfort, blending contemporary design with warm African touches.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% if (rooms && rooms.length > 0) { %>
        <% rooms.forEach((room, i) => { %>
          <div class="room-card bg-white rounded-2xl overflow-hidden shadow-md" data-aos="fade-up" data-aos-delay="<%= i * 100 %>">
            <div class="relative overflow-hidden h-64">
              <img src="<%= room.images && room.images[0] ? room.images[0] : 'https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=600&q=80' %>" 
                   alt="<%= room.name %>" 
                   class="room-image w-full h-full object-cover">
              <div class="absolute top-4 left-4">
                <span class="px-3 py-1 bg-navy-900/80 text-white text-xs font-medium rounded-full backdrop-blur-sm"><%= room.type %></span>
              </div>
              <div class="absolute bottom-4 right-4">
                <span class="px-4 py-2 bg-gold-500 text-navy-900 text-sm font-bold rounded-lg">
                  <%= room.price.toLocaleString() %> CFA<span class="text-xs font-normal">/night</span>
                </span>
              </div>
            </div>
            <div class="p-6">
              <div class="flex items-center gap-1 mb-2">
                <% for (let s = 0; s < 5; s++) { %>
                  <svg class="w-3.5 h-3.5 <%= s < Math.round(room.rating) ? 'text-gold-400' : 'text-gray-200' %>" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <% } %>
                <span class="text-xs text-gray-400 ml-1">(<%= room.reviewCount %>)</span>
              </div>
              <h3 class="text-xl font-serif font-bold text-navy-900 mb-2"><%= room.name %></h3>
              <p class="text-gray-500 text-sm mb-4 line-clamp-2"><%= room.shortDescription || room.description.substring(0, 100) + '...' %></p>
              <div class="flex items-center gap-4 mb-4 text-xs text-gray-400">
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                  Up to <%= room.capacity %> guests
                </span>
                <% if (room.size) { %>
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
                  <%= room.size %> m²
                </span>
                <% } %>
              </div>
              <a href="/rooms/<%= room.slug %>" class="block w-full text-center py-3 border-2 border-navy-900 text-navy-900 text-sm font-semibold rounded-lg hover:bg-navy-900 hover:text-white transition-all duration-300 uppercase tracking-wide">
                View Details
              </a>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-span-3 text-center py-16">
          <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          <p class="text-gray-400 text-lg">Rooms coming soon</p>
          <p class="text-gray-400 text-sm mt-1">Our luxury accommodations are being prepared for you.</p>
        </div>
      <% } %>
    </div>

    <div class="text-center mt-12" data-aos="fade-up">
      <a href="/rooms" class="inline-flex items-center gap-2 px-8 py-4 border-2 border-navy-900 text-navy-900 font-semibold rounded text-sm uppercase tracking-wider hover:bg-navy-900 hover:text-white transition-all duration-300">
        View All Rooms
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- Amenities -->
<section class="py-24 bg-navy-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16" data-aos="fade-up">
      <p class="text-gold-400 text-sm uppercase tracking-[0.2em] font-medium mb-4">Services</p>
      <h2 class="text-4xl md:text-5xl font-serif font-bold mb-4">Hotel Amenities</h2>
      <div class="gold-line mx-auto"></div>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
      <% const amenities = [
        { icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>', name: 'Pool' },
        { icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>', name: 'Free WiFi' },
        { icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 15.999A2 2 0 0119 18H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v10z"/>', name: 'Room Service' },
        { icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>', name: 'Spa' },
        { icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>', name: 'Restaurant' },
        { icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>', name: 'Gym' }
      ]; %>
      <% amenities.forEach((a, i) => { %>
        <div class="text-center p-6 rounded-xl bg-white/5 hover:bg-white/10 transition-all duration-300 group" data-aos="fade-up" data-aos-delay="<%= i * 80 %>">
          <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-gold-500/10 flex items-center justify-center group-hover:bg-gold-500/20 transition-all">
            <svg class="w-6 h-6 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><%- a.icon %></svg>
          </div>
          <p class="text-sm font-medium text-white/80"><%= a.name %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Gallery Preview -->
<% if (gallery && gallery.length > 0) { %>
<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16" data-aos="fade-up">
      <p class="text-gold-600 text-sm uppercase tracking-[0.2em] font-medium mb-4">Gallery</p>
      <h2 class="text-4xl md:text-5xl font-serif font-bold text-navy-900 mb-4">Moments at Oceanis</h2>
      <div class="gold-line mx-auto"></div>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <% gallery.forEach((img, i) => { %>
        <div class="gallery-item rounded-xl overflow-hidden <%= i === 0 || i === 3 ? 'md:row-span-2' : '' %>" data-aos="zoom-in" data-aos-delay="<%= i * 60 %>">
          <img src="<%= img.image %>" alt="<%= img.title || 'Oceanis Hotel' %>" class="w-full h-full object-cover min-h-[200px] <%= i === 0 || i === 3 ? 'md:min-h-[420px]' : '' %>">
        </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- CTA Section -->
<section class="relative py-32 hero-bg" style="background-image: url('https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?w=1920&q=80');">
  <div class="absolute inset-0 bg-navy-950/80"></div>
  <div class="relative z-10 max-w-3xl mx-auto px-4 text-center" data-aos="fade-up">
    <p class="text-gold-400 text-sm uppercase tracking-[0.2em] font-medium mb-4">Ready for Luxury?</p>
    <h2 class="text-4xl md:text-5xl font-serif font-bold text-white mb-6">Book Your Stay Today</h2>
    <p class="text-white/60 text-lg mb-10 font-light">
      Indulge in an experience that transcends the ordinary. Reserve your room at Oceanis and 
      create memories that last a lifetime.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/rooms" class="px-10 py-4 bg-gold-500 hover:bg-gold-600 text-navy-900 font-semibold rounded text-sm uppercase tracking-wider transition-all duration-300 animate-pulse-gold">
        Reserve Now
      </a>
      <a href="/contact" class="px-10 py-4 border border-white/30 text-white hover:bg-white/10 font-medium rounded text-sm uppercase tracking-wider transition-all duration-300">
        Contact Us
      </a>
    </div>
  </div>
</section>

<!-- Testimonials -->
<section class="py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16" data-aos="fade-up">
      <p class="text-gold-600 text-sm uppercase tracking-[0.2em] font-medium mb-4">Testimonials</p>
      <h2 class="text-4xl md:text-5xl font-serif font-bold text-navy-900 mb-4">Guest Reviews</h2>
      <div class="gold-line mx-auto"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% const reviews = [
        { name: 'Marie T.', location: 'Paris, France', text: 'An absolutely stunning hotel. The rooms are impeccable, the staff is incredibly warm, and the location is perfect. My best stay in Douala by far.', rating: 5 },
        { name: 'Jean-Pierre K.', location: 'Douala, Cameroon', text: 'Oceanis sets the standard for luxury hospitality in Cameroon. The attention to detail and service quality are truly world-class.', rating: 5 },
        { name: 'Sarah M.', location: 'London, UK', text: 'From the moment we arrived, everything was perfect. Beautiful rooms, amazing restaurant, and the pool area is a dream. Highly recommend!', rating: 5 }
      ]; %>
      <% reviews.forEach((r, i) => { %>
        <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow" data-aos="fade-up" data-aos-delay="<%= i * 100 %>">
          <div class="flex gap-1 mb-4">
            <% for (let s = 0; s < r.rating; s++) { %>
              <svg class="w-4 h-4 text-gold-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <% } %>
          </div>
          <p class="text-gray-600 text-sm leading-relaxed mb-6 italic">"<%= r.text %>"</p>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-ocean-100 flex items-center justify-center text-ocean-700 font-semibold text-sm">
              <%= r.name.charAt(0) %>
            </div>
            <div>
              <p class="text-sm font-semibold text-navy-900"><%= r.name %></p>
              <p class="text-xs text-gray-400"><%= r.location %></p>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
