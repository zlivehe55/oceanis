<%- include('partials/header') %>

<section class="pt-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-400 mb-8">
      <a href="/" class="hover:text-ocean-600 transition-colors">Home</a>
      <span class="mx-2">/</span>
      <a href="/rooms" class="hover:text-ocean-600 transition-colors">Rooms</a>
      <span class="mx-2">/</span>
      <span class="text-navy-900 font-medium"><%= room.name %></span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <!-- Left: Room Info -->
      <div class="lg:col-span-2">
        <!-- Image Gallery -->
        <div class="relative rounded-2xl overflow-hidden mb-8">
          <div id="main-image" class="w-full h-[400px] md:h-[500px]">
            <img src="<%= room.images && room.images[0] ? room.images[0] : 'https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=900&q=80' %>" 
                 alt="<%= room.name %>" class="w-full h-full object-cover" id="hero-img">
          </div>
          <div class="absolute top-4 left-4">
            <span class="px-4 py-1.5 bg-navy-900/80 text-white text-sm font-medium rounded-full backdrop-blur-sm"><%= room.type %></span>
          </div>
        </div>

        <% if (room.images && room.images.length > 1) { %>
        <div class="grid grid-cols-4 gap-3 mb-8">
          <% room.images.forEach((img, i) => { %>
            <button onclick="document.getElementById('hero-img').src='<%= img %>'" 
                    class="rounded-xl overflow-hidden h-24 border-2 hover:border-gold-500 transition-all <%= i === 0 ? 'border-gold-500' : 'border-transparent' %>">
              <img src="<%= img %>" alt="" class="w-full h-full object-cover">
            </button>
          <% }); %>
        </div>
        <% } %>

        <!-- Room Info -->
        <div class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <div class="flex gap-0.5">
              <% for (let s = 0; s < 5; s++) { %>
                <svg class="w-4 h-4 <%= s < Math.round(room.rating) ? 'text-gold-400' : 'text-gray-200' %>" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <% } %>
            </div>
            <span class="text-sm text-gray-500"><%= room.rating %> (<%= room.reviewCount %> reviews)</span>
          </div>
          <h1 class="text-3xl md:text-4xl font-serif font-bold text-navy-900 mb-4"><%= room.name %></h1>
          <div class="gold-line mb-6"></div>
        </div>

        <!-- Quick Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          <div class="bg-gray-50 rounded-xl p-4 text-center">
            <svg class="w-6 h-6 text-ocean-600 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            <p class="text-sm font-semibold text-navy-900"><%= room.capacity %> Guests</p>
            <p class="text-xs text-gray-400">Max Capacity</p>
          </div>
          <% if (room.size) { %>
          <div class="bg-gray-50 rounded-xl p-4 text-center">
            <svg class="w-6 h-6 text-ocean-600 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
            <p class="text-sm font-semibold text-navy-900"><%= room.size %> m²</p>
            <p class="text-xs text-gray-400">Room Size</p>
          </div>
          <% } %>
          <% if (room.bedType) { %>
          <div class="bg-gray-50 rounded-xl p-4 text-center">
            <svg class="w-6 h-6 text-ocean-600 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            <p class="text-sm font-semibold text-navy-900"><%= room.bedType %></p>
            <p class="text-xs text-gray-400">Bed Type</p>
          </div>
          <% } %>
          <div class="bg-gray-50 rounded-xl p-4 text-center">
            <svg class="w-6 h-6 text-ocean-600 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <p class="text-sm font-semibold text-navy-900">Free WiFi</p>
            <p class="text-xs text-gray-400">High Speed</p>
          </div>
        </div>

        <!-- Description -->
        <div class="mb-8">
          <h3 class="text-lg font-semibold text-navy-900 mb-4">About This Room</h3>
          <p class="text-gray-600 leading-relaxed whitespace-pre-line"><%= room.description %></p>
        </div>

        <!-- Amenities -->
        <% if (room.amenities && room.amenities.length > 0) { %>
        <div class="mb-8">
          <h3 class="text-lg font-semibold text-navy-900 mb-4">Amenities</h3>
          <div class="flex flex-wrap gap-2">
            <% room.amenities.forEach(a => { %>
              <span class="amenity-pill"><%= a %></span>
            <% }); %>
          </div>
        </div>
        <% } %>
      </div>

      <!-- Right: Booking Widget -->
      <div class="lg:col-span-1">
        <div class="sticky top-28 bg-white border border-gray-200 rounded-2xl p-6 shadow-lg">
          <div class="text-center mb-6">
            <p class="text-3xl font-serif font-bold text-navy-900 price-tag"><%= room.price.toLocaleString() %> <span class="text-lg">CFA</span></p>
            <p class="text-sm text-gray-400">per night</p>
          </div>
          <div class="section-divider mb-6"></div>

          <form action="/booking" method="POST" id="booking-form">
            <input type="hidden" name="roomId" value="<%= room._id %>">

            <div class="space-y-4 mb-6">
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Full Name</label>
                <input type="text" name="guestName" required placeholder="Your full name"
                  class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-ocean-500 transition-colors"
                  value="<%= typeof user !== 'undefined' && user ? user.name : '' %>">
              </div>
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Email</label>
                <input type="email" name="guestEmail" required placeholder="your@email.com"
                  class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-ocean-500 transition-colors"
                  value="<%= typeof user !== 'undefined' && user ? user.email : '' %>">
              </div>
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Phone</label>
                <input type="tel" name="guestPhone" required placeholder="+237 6XX XXX XXX"
                  class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-ocean-500 transition-colors"
                  value="<%= typeof user !== 'undefined' && user && user.phone ? user.phone : '' %>">
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Check In</label>
                  <input type="date" name="checkIn" required id="checkIn"
                    class="w-full border border-gray-200 rounded-lg px-3 py-3 text-sm focus:outline-none focus:border-ocean-500 transition-colors">
                </div>
                <div>
                  <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Check Out</label>
                  <input type="date" name="checkOut" required id="checkOut"
                    class="w-full border border-gray-200 rounded-lg px-3 py-3 text-sm focus:outline-none focus:border-ocean-500 transition-colors">
                </div>
              </div>
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Guests</label>
                <select name="guests" class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-ocean-500 transition-colors appearance-none bg-white">
                  <% for (let g = 1; g <= room.capacity; g++) { %>
                    <option value="<%= g %>"><%= g %> Guest<%= g > 1 ? 's' : '' %></option>
                  <% } %>
                </select>
              </div>
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wider mb-1.5">Special Requests</label>
                <textarea name="specialRequests" rows="3" placeholder="Any special requests..."
                  class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-ocean-500 transition-colors resize-none"></textarea>
              </div>
            </div>

            <!-- Price Summary -->
            <div class="bg-gray-50 rounded-xl p-4 mb-6">
              <div class="flex justify-between text-sm mb-2">
                <span class="text-gray-500"><%= room.price.toLocaleString() %> CFA x <span id="nights-count">0</span> night(s)</span>
                <span class="font-semibold text-navy-900" id="total-price">0 CFA</span>
              </div>
              <div class="border-t border-gray-200 pt-2 mt-2 flex justify-between">
                <span class="font-semibold text-navy-900">Total</span>
                <span class="font-bold text-lg text-navy-900" id="grand-total">0 CFA</span>
              </div>
            </div>

            <button type="submit" class="w-full py-4 bg-gold-500 hover:bg-gold-600 text-navy-900 font-bold rounded-xl text-sm uppercase tracking-wider transition-all duration-300 hover:shadow-lg hover:shadow-gold-500/25">
              Book Now
            </button>
          </form>

          <p class="text-center text-xs text-gray-400 mt-4">Pay at hotel or with card. Free cancellation up to 24h.</p>
        </div>
      </div>
    </div>

    <!-- Related Rooms -->
    <% if (relatedRooms && relatedRooms.length > 0) { %>
    <div class="mt-20 mb-12">
      <h3 class="text-2xl font-serif font-bold text-navy-900 mb-8">Similar Rooms</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% relatedRooms.forEach(r => { %>
          <a href="/rooms/<%= r.slug %>" class="room-card bg-white rounded-2xl overflow-hidden shadow-md block">
            <div class="relative overflow-hidden h-48">
              <img src="<%= r.images && r.images[0] ? r.images[0] : 'https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=600&q=80' %>" 
                   alt="<%= r.name %>" class="room-image w-full h-full object-cover">
              <div class="absolute bottom-3 right-3">
                <span class="px-3 py-1.5 bg-gold-500 text-navy-900 text-sm font-bold rounded-lg"><%= r.price.toLocaleString() %> CFA</span>
              </div>
            </div>
            <div class="p-5">
              <h4 class="font-serif font-bold text-navy-900"><%= r.name %></h4>
              <p class="text-sm text-gray-400 mt-1"><%= r.type %> &middot; Up to <%= r.capacity %> guests</p>
            </div>
          </a>
        <% }); %>
      </div>
    </div>
    <% } %>
  </div>
</section>

<script>
  const pricePerNight = <%= room.price %>;
  const checkIn = document.getElementById('checkIn');
  const checkOut = document.getElementById('checkOut');

  const today = new Date().toISOString().split('T')[0];
  checkIn.min = today;
  checkOut.min = today;

  function updatePrice() {
    if (checkIn.value && checkOut.value) {
      const start = new Date(checkIn.value);
      const end = new Date(checkOut.value);
      const nights = Math.ceil((end - start) / (1000 * 60 * 60 * 24));
      if (nights > 0) {
        const total = pricePerNight * nights;
        document.getElementById('nights-count').textContent = nights;
        document.getElementById('total-price').textContent = total.toLocaleString() + ' CFA';
        document.getElementById('grand-total').textContent = total.toLocaleString() + ' CFA';
      }
    }
  }

  checkIn.addEventListener('change', () => {
    if (checkIn.value) {
      const next = new Date(checkIn.value);
      next.setDate(next.getDate() + 1);
      checkOut.min = next.toISOString().split('T')[0];
      if (checkOut.value && new Date(checkOut.value) <= new Date(checkIn.value)) {
        checkOut.value = next.toISOString().split('T')[0];
      }
    }
    updatePrice();
  });
  checkOut.addEventListener('change', updatePrice);
</script>

<%- include('partials/footer') %>
