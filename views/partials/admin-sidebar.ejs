<% const adminPath = typeof currentPath !== 'undefined' ? currentPath : ''; %>

<!-- Mobile overlay -->
<div id="sidebar-overlay" class="fixed inset-0 bg-black/50 z-30 md:hidden hidden" onclick="document.getElementById('admin-sidebar').classList.add('-translate-x-full');this.classList.add('hidden');"></div>

<!-- Mobile top bar -->
<div class="md:hidden fixed top-0 left-0 right-0 h-16 bg-navy-950 z-30 flex items-center px-4 gap-3">
  <button onclick="document.getElementById('admin-sidebar').classList.remove('-translate-x-full');document.getElementById('sidebar-overlay').classList.remove('hidden');" class="text-white p-2">
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
  </button>
  <span class="text-white font-serif font-bold">Oceanis Admin</span>
</div>

<aside id="admin-sidebar" class="fixed inset-y-0 left-0 w-64 bg-navy-950 text-white z-40 flex flex-col transition-transform duration-300 -translate-x-full md:translate-x-0">
  <div class="p-6 border-b border-white/10 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
           class="w-7 h-7 text-gold-500">
        <path d="M10 22v-6.57"/><path d="M12 11h.01"/><path d="M12 7h.01"/>
        <path d="M14 15.43V22"/><path d="M15 16a5 5 0 0 0-6 0"/>
        <path d="M16 11h.01"/><path d="M16 7h.01"/><path d="M8 11h.01"/><path d="M8 7h.01"/>
        <rect x="4" y="2" width="16" height="20" rx="2"/>
      </svg>
      <div>
        <span class="text-lg font-serif font-bold tracking-wide">Oceanis</span>
        <span class="block text-[10px] text-gold-500 uppercase tracking-widest">Admin Panel</span>
      </div>
    </a>
    <button onclick="document.getElementById('admin-sidebar').classList.add('-translate-x-full');document.getElementById('sidebar-overlay').classList.add('hidden');" class="md:hidden text-white/50 hover:text-white p-1">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <nav class="flex-1 px-4 py-6 space-y-1 overflow-y-auto">
    <a href="/admin" class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm transition-all
      <%= adminPath === '/admin' ? 'bg-ocean-600/20 text-gold-400' : 'text-white/60 hover:text-white hover:bg-white/5' %>">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      Dashboard
    </a>
    <a href="/admin/rooms" class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm transition-all
      <%= adminPath.startsWith('/admin/rooms') ? 'bg-ocean-600/20 text-gold-400' : 'text-white/60 hover:text-white hover:bg-white/5' %>">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
      Rooms
    </a>
    <a href="/admin/bookings" class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm transition-all
      <%= adminPath.startsWith('/admin/bookings') ? 'bg-ocean-600/20 text-gold-400' : 'text-white/60 hover:text-white hover:bg-white/5' %>">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      Bookings
    </a>
    <a href="/admin/gallery" class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm transition-all
      <%= adminPath.startsWith('/admin/gallery') ? 'bg-ocean-600/20 text-gold-400' : 'text-white/60 hover:text-white hover:bg-white/5' %>">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      Gallery
    </a>
    <a href="/admin/contacts" class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm transition-all
      <%= adminPath.startsWith('/admin/contacts') ? 'bg-ocean-600/20 text-gold-400' : 'text-white/60 hover:text-white hover:bg-white/5' %>">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      Messages
    </a>
  </nav>

  <div class="p-4 border-t border-white/10">
    <div class="flex items-center gap-3 px-4 py-2">
      <div class="w-9 h-9 rounded-full bg-ocean-600 flex items-center justify-center text-white text-sm font-semibold">
        <%= typeof user !== 'undefined' && user ? user.name.charAt(0).toUpperCase() : 'A' %>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium text-white truncate"><%= typeof user !== 'undefined' && user ? user.name : 'Admin' %></p>
        <p class="text-xs text-white/40 truncate"><%= typeof user !== 'undefined' && user ? user.email : '' %></p>
      </div>
    </div>
    <a href="/auth/logout" class="flex items-center gap-2 px-4 py-2 mt-2 text-xs text-white/50 hover:text-red-400 transition-colors">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      Sign Out
    </a>
  </div>
</aside>
