<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Oceanis - Luxury Hotel in Douala, Cameroon' %></title>

  <!-- SEO Meta -->
  <meta name="description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'Oceanis Hotel - Experience world-class luxury hospitality in Douala, Cameroon. Book elegant rooms, suites & enjoy premium amenities on the Atlantic coast.' %>">
  <meta name="keywords" content="hotel douala, luxury hotel cameroon, oceanis hotel, hotel booking douala, best hotel cameroon, rooms douala, suite cameroon, accommodation douala">
  <meta name="author" content="Oceanis Hotel">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://oceanis-cm.com<%= typeof currentPath !== 'undefined' ? currentPath : '/' %>">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Oceanis Hotel">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Oceanis - Luxury Hotel in Douala' %>">
  <meta property="og:description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'Experience world-class luxury hospitality in Douala, Cameroon. Book your stay at Oceanis Hotel.' %>">
  <meta property="og:url" content="https://oceanis-cm.com<%= typeof currentPath !== 'undefined' ? currentPath : '/' %>">
  <meta property="og:image" content="https://images.unsplash.com/photo-1566073771259-6a8506099945?w=1200&q=80">
  <meta property="og:locale" content="en_US">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'Oceanis - Luxury Hotel in Douala' %>">
  <meta name="twitter:description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'Experience world-class luxury hospitality in Douala, Cameroon.' %>">
  <meta name="twitter:image" content="https://images.unsplash.com/photo-1566073771259-6a8506099945?w=1200&q=80">

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Hotel",
    "name": "Oceanis Hotel",
    "description": "Luxury hotel in Douala, Cameroon offering world-class hospitality on the Atlantic coast.",
    "url": "https://oceanis-cm.com",
    "email": "oceaniscm@gmail.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Bonanjo District",
      "addressLocality": "Douala",
      "addressCountry": "CM"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "4.0483",
      "longitude": "9.6756"
    },
    "image": "https://images.unsplash.com/photo-1566073771259-6a8506099945?w=1200&q=80",
    "priceRange": "CFA 22,000 - CFA 150,000",
    "starRating": { "@type": "Rating", "ratingValue": "4.8" },
    "amenityFeature": [
      {"@type": "LocationFeatureSpecification", "name": "Free WiFi"},
      {"@type": "LocationFeatureSpecification", "name": "Swimming Pool"},
      {"@type": "LocationFeatureSpecification", "name": "Restaurant"},
      {"@type": "LocationFeatureSpecification", "name": "Spa"},
      {"@type": "LocationFeatureSpecification", "name": "Room Service"},
      {"@type": "LocationFeatureSpecification", "name": "Gym"}
    ]
  }
  </script>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23c9a84c' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M10 22v-6.57'/><path d='M12 11h.01'/><path d='M12 7h.01'/><path d='M14 15.43V22'/><path d='M15 16a5 5 0 0 0-6 0'/><path d='M16 11h.01'/><path d='M16 7h.01'/><path d='M8 11h.01'/><path d='M8 7h.01'/><rect x='4' y='2' width='16' height='20' rx='2'/></svg>">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            ocean: {
              50: '#f0f7ff', 100: '#e0effe', 200: '#b9dffe', 300: '#7cc5fd',
              400: '#36a9fa', 500: '#0c8eeb', 600: '#0070c9', 700: '#0159a3',
              800: '#064b86', 900: '#0b3f6f', 950: '#07284a',
            },
            gold: {
              50: '#fdfaef', 100: '#f9f0d0', 200: '#f3de9d', 300: '#ecc96a',
              400: '#e5b43e', 500: '#d4982a', 600: '#c9a84c', 700: '#8f6417',
              800: '#76501a', 900: '#63431b', 950: '#39230b',
            },
            navy: { 800: '#1a2744', 900: '#0f172a', 950: '#080d1a' }
          },
          fontFamily: {
            serif: ['Cormorant Garamond', 'Georgia', 'serif'],
            sans: ['Inter', 'system-ui', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/aos@2.3.4/dist/aos.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="font-sans text-gray-800 bg-white">

  <% if (typeof flash !== 'undefined' && flash) { %>
  <div id="flash-msg" class="fixed top-4 right-4 z-[200] max-w-md animate-slide-in">
    <div class="px-6 py-4 rounded-lg shadow-2xl border
      <%= flash.type === 'success' ? 'bg-emerald-50 border-emerald-200 text-emerald-800' : 'bg-red-50 border-red-200 text-red-800' %>">
      <div class="flex items-center gap-3">
        <% if (flash.type === 'success') { %>
          <svg class="w-5 h-5 text-emerald-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <% } else { %>
          <svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        <% } %>
        <p class="text-sm font-medium"><%= flash.message %></p>
        <button onclick="this.closest('#flash-msg').remove()" class="ml-auto text-gray-400 hover:text-gray-600">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
  </div>
  <script>setTimeout(() => { const el = document.getElementById('flash-msg'); if (el) el.remove(); }, 5000);</script>
  <% } %>

  <!-- Navigation - isolated stacking context with highest z-index -->
  <header id="navbar-wrapper" style="position:fixed;top:0;left:0;right:0;z-index:9999;pointer-events:auto;">
    <nav id="navbar" class="transition-all duration-500 bg-navy-900/95 backdrop-blur-md shadow-lg"
      data-home="<%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'true' : 'false' %>">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
          <a href="/" class="flex items-center gap-3 group relative z-10">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 class="w-9 h-9 text-gold-500 group-hover:text-gold-400 transition-colors">
              <path d="M10 22v-6.57"/><path d="M12 11h.01"/><path d="M12 7h.01"/>
              <path d="M14 15.43V22"/><path d="M15 16a5 5 0 0 0-6 0"/>
              <path d="M16 11h.01"/><path d="M16 7h.01"/><path d="M8 11h.01"/><path d="M8 7h.01"/>
              <rect x="4" y="2" width="16" height="20" rx="2"/>
            </svg>
            <span class="text-2xl font-serif font-bold text-white tracking-wide">Oceanis</span>
          </a>

          <div class="hidden md:flex items-center gap-8 relative z-10">
            <a href="/" class="text-sm font-medium text-white/80 hover:text-gold-400 transition-colors tracking-wide uppercase">Home</a>
            <a href="/rooms" class="text-sm font-medium text-white/80 hover:text-gold-400 transition-colors tracking-wide uppercase">Rooms</a>
            <a href="/about" class="text-sm font-medium text-white/80 hover:text-gold-400 transition-colors tracking-wide uppercase">About</a>
            <a href="/contact" class="text-sm font-medium text-white/80 hover:text-gold-400 transition-colors tracking-wide uppercase">Contact</a>
            <% if (typeof user !== 'undefined' && user) { %>
              <% if (user.role === 'admin') { %>
                <a href="/admin" class="text-sm font-medium text-gold-400 hover:text-gold-300 transition-colors tracking-wide uppercase">Admin</a>
              <% } %>
              <a href="/auth/logout" class="ml-2 px-6 py-2.5 bg-gold-500 hover:bg-gold-600 text-navy-900 text-sm font-semibold rounded transition-all duration-300 tracking-wide">Logout</a>
            <% } else { %>
              <a href="/auth/login" class="text-sm font-medium text-white/80 hover:text-gold-400 transition-colors tracking-wide uppercase">Login</a>
              <a href="/rooms" class="ml-2 px-6 py-2.5 bg-gold-500 hover:bg-gold-600 text-navy-900 text-sm font-semibold rounded transition-all duration-300 tracking-wide">Book Now</a>
            <% } %>
          </div>

          <button id="mobile-toggle" class="md:hidden text-white p-2 relative z-10" aria-label="Toggle menu">
            <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
            <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>

      <div id="mobile-menu" class="hidden md:hidden bg-navy-900 border-t border-white/10">
        <div class="px-4 py-4 space-y-1">
          <a href="/" class="block text-sm text-white/80 hover:text-gold-400 hover:bg-white/5 py-3 px-4 rounded-lg uppercase tracking-wide">Home</a>
          <a href="/rooms" class="block text-sm text-white/80 hover:text-gold-400 hover:bg-white/5 py-3 px-4 rounded-lg uppercase tracking-wide">Rooms</a>
          <a href="/about" class="block text-sm text-white/80 hover:text-gold-400 hover:bg-white/5 py-3 px-4 rounded-lg uppercase tracking-wide">About</a>
          <a href="/contact" class="block text-sm text-white/80 hover:text-gold-400 hover:bg-white/5 py-3 px-4 rounded-lg uppercase tracking-wide">Contact</a>
          <% if (typeof user !== 'undefined' && user) { %>
            <% if (user.role === 'admin') { %>
              <a href="/admin" class="block text-sm text-gold-400 hover:bg-white/5 py-3 px-4 rounded-lg uppercase tracking-wide">Admin Panel</a>
            <% } %>
            <a href="/auth/logout" class="block text-sm text-white/80 hover:text-gold-400 hover:bg-white/5 py-3 px-4 rounded-lg uppercase tracking-wide">Logout</a>
          <% } else { %>
            <a href="/auth/login" class="block text-sm text-white/80 hover:text-gold-400 hover:bg-white/5 py-3 px-4 rounded-lg uppercase tracking-wide">Login</a>
            <a href="/rooms" class="block w-full text-center px-6 py-3 mt-2 bg-gold-500 text-navy-900 text-sm font-semibold rounded-lg">Book Now</a>
          <% } %>
        </div>
      </div>
    </nav>
  </header>

  <main>
