<%- include('partials/header') %>

<!-- Page Header -->
<section class="pt-32 pb-20 bg-navy-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="text-gold-400 text-sm uppercase tracking-[0.2em] font-medium mb-4">Accommodation</p>
    <h1 class="text-4xl md:text-5xl font-serif font-bold text-white mb-4">Our Rooms & Suites</h1>
    <div class="gold-line mx-auto mb-6"></div>
    <p class="text-white/60 max-w-xl mx-auto">Discover the perfect retreat for your stay in Douala. Every room is designed for your ultimate comfort.</p>
  </div>
</section>

<!-- Filters -->
<section class="bg-white border-b sticky top-20 z-30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <form action="/rooms" method="GET" class="flex flex-wrap items-center gap-4">
      <div class="flex items-center gap-2 flex-wrap">
        <a href="/rooms" class="px-4 py-2 rounded-full text-sm font-medium transition-all
          <%= currentType === 'all' ? 'bg-navy-900 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>">All</a>
        <% types.forEach(t => { %>
          <a href="/rooms?type=<%= t %><%= currentSort !== 'newest' ? '&sort=' + currentSort : '' %>" 
             class="px-4 py-2 rounded-full text-sm font-medium transition-all
             <%= currentType === t ? 'bg-navy-900 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>"><%= t %></a>
        <% }); %>
      </div>
      <div class="ml-auto flex items-center gap-3">
        <input type="text" name="search" value="<%= search %>" placeholder="Search rooms..." 
               class="px-4 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-ocean-500 w-48">
        <select name="sort" onchange="this.form.submit()" class="px-4 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-ocean-500 appearance-none bg-white">
          <option value="newest" <%= currentSort === 'newest' ? 'selected' : '' %>>Newest</option>
          <option value="price-low" <%= currentSort === 'price-low' ? 'selected' : '' %>>Price: Low to High</option>
          <option value="price-high" <%= currentSort === 'price-high' ? 'selected' : '' %>>Price: High to Low</option>
          <option value="rating" <%= currentSort === 'rating' ? 'selected' : '' %>>Top Rated</option>
        </select>
        <input type="hidden" name="type" value="<%= currentType %>">
      </div>
    </form>
  </div>
</section>

<!-- Rooms Grid -->
<section class="py-16 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <% if (rooms && rooms.length > 0) { %>
      <p class="text-sm text-gray-400 mb-8"><%= rooms.length %> room<%= rooms.length !== 1 ? 's' : '' %> found</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% rooms.forEach((room, i) => { %>
          <div class="room-card bg-white rounded-2xl overflow-hidden shadow-md" data-aos="fade-up" data-aos-delay="<%= (i % 3) * 100 %>">
            <div class="relative overflow-hidden h-64">
              <img src="<%= room.images && room.images[0] ? room.images[0] : 'https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=600&q=80' %>" 
                   alt="<%= room.name %>" class="room-image w-full h-full object-cover">
              <div class="absolute top-4 left-4">
                <span class="px-3 py-1 bg-navy-900/80 text-white text-xs font-medium rounded-full backdrop-blur-sm"><%= room.type %></span>
              </div>
              <div class="absolute bottom-4 right-4">
                <span class="px-4 py-2 bg-gold-500 text-navy-900 text-sm font-bold rounded-lg price-tag">
                  <%= room.price.toLocaleString() %> CFA<span class="text-xs font-normal">/night</span>
                </span>
              </div>
            </div>
            <div class="p-6">
              <div class="flex items-center gap-1 mb-2">
                <% for (let s = 0; s < 5; s++) { %>
                  <svg class="w-3.5 h-3.5 <%= s < Math.round(room.rating) ? 'text-gold-400' : 'text-gray-200' %>" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <% } %>
                <span class="text-xs text-gray-400 ml-1"><%= room.rating %> (<%= room.reviewCount %>)</span>
              </div>
              <h3 class="text-xl font-serif font-bold text-navy-900 mb-2"><%= room.name %></h3>
              <p class="text-gray-500 text-sm mb-4 line-clamp-2"><%= room.shortDescription || room.description.substring(0, 120) %></p>
              <div class="flex items-center gap-4 mb-5 text-xs text-gray-400">
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                  <%= room.capacity %> guests
                </span>
                <% if (room.size) { %>
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
                  <%= room.size %> m²
                </span>
                <% } %>
                <% if (room.bedType) { %>
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                  <%= room.bedType %>
                </span>
                <% } %>
              </div>
              <a href="/rooms/<%= room.slug %>" class="block w-full text-center py-3 border-2 border-navy-900 text-navy-900 text-sm font-semibold rounded-lg hover:bg-navy-900 hover:text-white transition-all duration-300 uppercase tracking-wide">
                View Details
              </a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="text-center py-24">
        <svg class="w-20 h-20 text-gray-300 mx-auto mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <h3 class="text-xl font-semibold text-gray-600 mb-2">No rooms found</h3>
        <p class="text-gray-400 mb-6">Try adjusting your search or filter criteria.</p>
        <a href="/rooms" class="inline-flex px-6 py-3 bg-navy-900 text-white text-sm font-medium rounded-lg hover:bg-navy-800 transition-colors">
          Clear Filters
        </a>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
